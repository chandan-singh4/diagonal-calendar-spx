# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your real values.
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# .env is gitignored and must NEVER be committed — it holds live broker
# API credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Schwab API credentials (REQUIRED) ────────────────────────────────────────
# Register an app at https://developer.schwab.com (this account is separate
# from your trading login). Select the "Market Data Production" product —
# this tool only reads data and never places orders. Approval takes 1-3
# business days.
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Must match the callback URL registered on the Schwab developer portal
# EXACTLY. The default below works with the manual OAuth flow this project
# uses (see schwab_client.get_client() for why the manual flow was chosen).
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# ── Local paths (optional — defaults are fine) ───────────────────────────────
# Both are resolved relative to the project root.
SCHWAB_TOKEN_PATH=data/token.json
DB_PATH=data/dashboard.db

# ── Watchdog email alerts (OPTIONAL — M3.4) ──────────────────────────────────
# scripts/watchdog.py raises a desktop pop-up when collection stops. Fill these
# in as well and it also emails, so the alarm reaches you away from this PC.
#
# LEAVING THESE BLANK IS A VALID CHOICE: email is skipped and the pop-up still
# works. What you must not do is fill in half of them — an address with no
# password does not send, and the watchdog says so loudly rather than
# pretending, because believing you are covered when you are not is worse than
# knowing you are not.
#
# GMAIL NEEDS AN APP PASSWORD, not your normal Google password — Google
# rejects ordinary passwords from scripts. Get one at
# https://myaccount.google.com/apppasswords (requires 2-step verification to
# be switched on first). It is a 16-character string. It grants mail-sending
# access to this machine only; you can revoke it from that same page at any
# time without changing your real password.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_PASSWORD=

# Defaults suit Gmail; change only for a different provider.
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587

# ─────────────────────────────────────────────────────────────────────────────
# REMOVED SETTINGS — do not re-add
#
#   DEMO_MODE               Demo Mode was removed from the dashboard. The
#                           config flag had no consumers and demo_data.py is
#                           orphaned. Deleted in M0.
#   POLL_INTERVAL_SECONDS   Never read by config.py. Polling is session-aware
#                           and set by POLL_INTERVAL_NORMAL / _EVENT in
#                           config.py (300s midday, 60s at open/close).
# ─────────────────────────────────────────────────────────────────────────────
